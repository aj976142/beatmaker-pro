{
  "name": "beat-maker-pro",
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "samples": "python3 scripts/gen_samples.py",
    "prebuild": "expo prebuild --platform android --clean",
    "build:apk": "eas build -p android --profile preview",
    "web:export": "expo export --platform web",
    "windows": "npm run samples && npm run web:export && electron .",
    "windows:dist": "npm run samples && npm run web:export && electron-builder --win",
    "test:scheduler": "node scripts/test_scheduler.mjs"
  },
  "dependencies": {
    "@react-native-community/slider": "5.0.1",
    "expo": "~54.0.37",
    "expo-av": "~16.0.8",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.544.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-runtime": "~6.1.2",
    "babel-preset-expo": "~54.0.12",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "react-dom": "^19.1.0",
    "react-native-web": "^0.21.2"
  },
  "build": {
    "appId": "com.beatmaker.beatforge",
    "productName": "BeatForge",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "BeatForge-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
